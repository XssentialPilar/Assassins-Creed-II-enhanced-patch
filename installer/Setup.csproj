<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AC2-Enhanced-Patch-Setup</AssemblyName>
    <RootNamespace>Ac2Setup</RootNamespace>
    <ApplicationIcon>setup.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="setup.ico" />
    <EmbeddedResource Include="$(PatchZip)" LogicalName="Ac2Setup.Patch.zip" Condition="'$(PatchZip)' != ''" />
  </ItemGroup>
  <Target Name="VerifyPayload" BeforeTargets="PrepareForBuild" Condition="'$(PatchZip)' == ''">
    <Error Text="Pass the tested patch ZIP with -p:PatchZip=PATH." />
  </Target>
</Project>
