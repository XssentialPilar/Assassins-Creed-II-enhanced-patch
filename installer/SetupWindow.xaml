<Window x:Class="Ac2Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assassin’s Creed II Enhanced Patch Setup" Icon="setup.ico"
        Width="978" Height="663" MinWidth="850" MinHeight="625" WindowStartupLocation="CenterScreen"
        Background="#EBE8E2" Foreground="#28282A" FontFamily="Segoe UI" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#28282A" />
    <SolidColorBrush x:Key="Muted" Color="#54535A" />
    <SolidColorBrush x:Key="Accent" Color="#95273A" />
    <SolidColorBrush x:Key="Line" Color="#D5D0CB" />
    <Style TargetType="Button">
      <Setter Property="Background" Value="#F8F5F2"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="15,9"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Window.Resources>
  <Grid x:Name="Page">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="292"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid Background="#E6E1DB" ClipToBounds="True">
      <Canvas IsHitTestVisible="False" Opacity=".83">
        <Path Stroke="#FAF8F5" StrokeThickness="1" Data="M-140,566 L322,104 M-104,584 L348,132 M-64,604 L382,158 M-24,624 L408,190 M10,650 L447,213 M-180,265 L327,772 M-160,226 L347,733 M-140,187 L367,694 M-120,148 L387,655"/>
        <Path Stroke="#B8AAA5" StrokeThickness="1" Opacity=".55" Data="M-40,495 L103,352 263,512 118,657 Z M-28,498 L105,365 250,512 116,647 Z M-15,501 L105,380 238,512 116,634 Z"/>
        <Path Fill="#9D2339" Opacity=".84" Data="M-14,523 L100,409 200,509 87,622 Z"/>
        <Path Fill="#C75765" Opacity=".82" Data="M-14,523 L100,409 149,459 35,572 Z"/>
        <Path Fill="#F7F3EF" Opacity=".55" Data="M117,359 L177,299 236,358 177,417 Z M194,273 L222,245 250,273 222,301 Z M224,412 L263,373 302,412 263,451 Z M174,569 L228,515 282,569 228,623 Z"/>
        <Path Stroke="#FFFFFF" StrokeThickness="1" Data="M-14,523 L100,409 200,509 87,622 Z M35,572 L149,459 M117,359 L177,299 236,358 177,417 Z M194,273 L222,245 250,273 222,301 Z M224,412 L263,373 302,412 263,451 Z"/>
      </Canvas>
      <StackPanel Margin="32,36,28,0" VerticalAlignment="Top">
        <Viewbox Width="56" Height="56" HorizontalAlignment="Left" Margin="0,0,0,29">
          <Canvas Width="64" Height="64">
            <Border Width="62" Height="62" CornerRadius="13" Background="#252229" BorderBrush="#52434B" BorderThickness="1" Canvas.Left="1" Canvas.Top="1"/>
            <Path Fill="#992B3E" Stroke="#F4DDE0" StrokeThickness="1.2" Data="M32,7 L56,31 32,56 8,31 Z"/>
            <Path Fill="#BD4A59" Data="M32,8 L44,20 20,44 9,31 Z"/>
            <Path Stroke="#F4DDE0" StrokeThickness="1.1" Data="M20,19 L44,44 M20,44 L44,19"/>
            <Path Fill="#252229" Stroke="#FFF7F2" StrokeThickness="1.2" Data="M32,23 L40,31 32,39 24,31 Z M28,31 L36,31"/>
          </Canvas>
        </Viewbox>
        <TextBlock FontSize="24" FontWeight="Light" Text="Assassin’s Creed II"/>
        <TextBlock FontSize="36" FontWeight="Light" Text="Enhanced Patch" LineHeight="42" Margin="0,4,0,14"/>
        <Border Background="{StaticResource Accent}" Width="44" Height="3" HorizontalAlignment="Left" Margin="0,2,0,16"/>
        <TextBlock FontSize="13.5" Foreground="{StaticResource Muted}" Text="Community patch for the Windows Steam edition." Width="194" HorizontalAlignment="Left"/>
          <TextBlock x:Name="VersionLabel" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,10,0,0"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Column="1" Background="#F4F1EE" Margin="0">
      <Grid Margin="36,30,36,24">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="Install Enhanced Patch" FontSize="32" FontWeight="Light"/>
          <TextBlock Text="Choose your Steam game folder and input preferences." FontSize="14" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,22,0,11">
          <StackPanel>
            <TextBlock Text="Game folder" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,9"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="GameFolder" AutomationProperties.Name="Game folder" FontSize="13" VerticalContentAlignment="Center"
                       Padding="10,8" BorderBrush="{StaticResource Line}" Background="#FFFEFC"/>
              <Button x:Name="BrowseButton" Grid.Column="1" Margin="8,0,0,0" Content="Browse…" Click="BrowseFolder"/>
            </Grid>
            <Border Background="#FFFCF9" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16,13" Margin="0,16,0,0">
              <StackPanel>
                <Label Target="{Binding ElementName=PromptMode}" FontSize="14" FontWeight="SemiBold"
                       Content="Keyboard and mouse prompts" Padding="0" Margin="0,0,0,7"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ComboBox x:Name="PromptMode" FontSize="14" Padding="9,6">
                    <ComboBoxItem Content="Show assigned keys"/>
                    <ComboBoxItem Content="Show original game icons"/>
                  </ComboBox>
                  <Button x:Name="PromptArtworkButton" Grid.Column="1" Margin="9,0,0,0" Padding="12,6"
                          Content="View input prompts" Click="ShowPromptArtwork"/>
                </Grid>
                <TextBlock Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,7,0,0"
                           Text="To switch while playing, press Ctrl + Alt + F11."/>
              </StackPanel>
            </Border>
            <Border Background="#FFFCF9" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16,13" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock FontWeight="SemiBold" FontSize="15" Text="Wireless controllers"/>
                <TextBlock Foreground="{StaticResource Muted}" FontSize="13" Margin="0,5,0,12"
                           Text="Pair DualShock 4, DualSense, and Bluetooth-capable Xbox controllers in Windows before launching the game."/>
                <CheckBox x:Name="InstallPs3" Content="Set up DualShock 3 Bluetooth support" FontSize="14" FontWeight="SemiBold" AutomationProperties.Name="Install DualShock 3 drivers"/>
                <TextBlock Foreground="{StaticResource Muted}" FontSize="12.5" Margin="19,7,0,0"
                           Text="Downloads and verifies the official DsHidMini and BthPS3 installers. Connect DualShock 3 by USB once to pair it, then select the SXS profile for PlayStation button prompts."/>
                <TextBlock Margin="0,11,0,0" FontSize="12.5"><Hyperlink Foreground="{StaticResource Accent}" Click="OpenBluetooth">Open Windows Bluetooth settings</Hyperlink></TextBlock>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2">
          <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,12">
            <StackPanel>
              <TextBlock x:Name="Status" FontSize="13" Foreground="{StaticResource Muted}"
                         Text="Existing patch files will be backed up before installation." AutomationProperties.LiveSetting="Polite"/>
              <ProgressBar x:Name="Progress" Height="3" Margin="0,8,0,0" Foreground="{StaticResource Accent}" Visibility="Collapsed"/>
            </StackPanel>
          </Border>
          <DockPanel LastChildFill="False">
            <Button x:Name="RestoreButton" Content="Restore previous files" Click="RestorePatch" DockPanel.Dock="Left"/>
            <Button x:Name="InstallButton" Content="Install patch" IsDefault="True" Click="InstallPatch" DockPanel.Dock="Right"
                    MinWidth="137" Foreground="White" Background="{StaticResource Accent}" BorderBrush="{StaticResource Accent}"/>
          </DockPanel>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
