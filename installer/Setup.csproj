<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AC2-Enhanced-Patch-Setup</AssemblyName>
    <RootNamespace>Ac2Setup</RootNamespace>
    <ApplicationIcon>setup.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DefaultItemExcludes>$(DefaultItemExcludes);payload/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="setup.ico" />
    <EmbeddedResource Include="locales/*.txt" />
    <ProjectReference Include="payload/SetupPayload.csproj" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>
